# ═══════════════════════════════════════════════════════
# LTC RAG Bot v2.0 · 环境配置
# ═══════════════════════════════════════════════════════

# ── 飞书机器人凭证（必填：没有就不能回消息） ──
# 飞书开放平台 → 你的应用 → 凭证与基础信息
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── API Key 鉴权（开发模式留空用默认值；生产必须改） ──
# 改为非默认值后，/ingest /query 等端点需要 X-API-Key header
API_KEY=dev-only-key-change-in-prod

# ── Ollama 本地 LLM（可选：装了 Ollama 自动检测） ──
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# ── 云端 LLM（可选：优先级高于 Ollama，性价比最高） ──
# DeepSeek: https://platform.deepseek.com/ 开通后拿 API Key
DEEPSEEK_API_KEY=
